{
  "name": "utopia",
  "version": "3.9.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "AI 角色扮演 Agent —— 让角色真正活起来的工具集",
  "repository": {
    "type": "git",
    "url": "https://github.com/404NotFoundObject/utopia.git"
  },
  "scripts": {
    "dev": "python -m http.server 8080",
    "dev:node": "npx serve -l 8080",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:dom": "vitest run tests/dom",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check:pwa": "node tools/check-pwa.mjs",
    "check:smoke": "node tools/smoke-full.mjs",
    "check:crud": "node tools/smoke-crud.mjs",
    "check:all": "npm run test && npm run check:pwa && npm run check:smoke && npm run check:crud && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitest/coverage-v8": "^5.0.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.1",
    "vitest": "^5.0.2"
  }
}
